@model PRG.EVA01.SeaBattle.Models.GameLog

@{
    ViewData["Title"] = "Delete Game Log";
}

<h1>Delete Game Log</h1>

<h4>Are you sure you want to delete this log?</h4>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Id</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            <dt class="col-sm-3">Player</dt>
            <dd class="col-sm-9">@Model.PlayerName</dd>

            <dt class="col-sm-3">PlayerName</dt>
            <dd class="col-sm-9">@(Model.Game?.PlayerName ?? "-")</dd>

            <dt class="col-sm-3">Location</dt>
            <dd class="col-sm-9">@($"{Model.LocationLetter} / {Model.LocationNumber}")</dd>

            <dt class="col-sm-3">Result</dt>
            <dd class="col-sm-9">@Model.Result</dd>

            <dt class="col-sm-3">Created On (UTC)</dt>
            <dd class="col-sm-9">@Model.CreatedOn.ToString("u")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>