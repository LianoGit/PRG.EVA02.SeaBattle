@model IEnumerable<PRG.EVA01.SeaBattle.Models.Boat>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                Location
            </th>
            <th>
                Game
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var boat in Model) {
        <tr>
            <td>@boat.Status</td>
            <td>@boat.LocationId</td>
            <td>@boat.GameId</td>
            <td>
                <a asp-action="Edit" asp-route-id="@boat.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@boat.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@boat.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
