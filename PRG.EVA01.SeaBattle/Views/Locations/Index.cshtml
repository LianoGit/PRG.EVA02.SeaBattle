@model IEnumerable<PRG.EVA01.SeaBattle.Models.Location>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Letter)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Number)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var location in Model) {
        <tr>
            <td>@location.Letter</td>
            <td>@location.Number</td>
            <td>
                <a asp-action="Edit" asp-route-id="@location.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@location.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@location.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
