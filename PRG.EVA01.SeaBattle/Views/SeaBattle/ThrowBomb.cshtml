@model PRG.EVA01.SeaBattle.Models.Game

@{
    Layout = "_Layout";
    ViewData["Title"] = "Throw Bomb";

    var message = ViewData["ThrowBombMessage"] as string ?? string.Empty;
    var statusClass = ViewData["ThrowBombStatusClass"] as string ?? string.Empty;
    var location = ViewData["Location"]?.ToString() ?? "";
    var sunkCount = ViewData["SunkCount"]?.ToString() ?? "0";

    var boats = Model?.Boats ?? Enumerable.Empty<Boat>();
}

<h1>SeaBattle</h1>

<ul>
    <li>Game id: @Model!.Id</li>
    <li>PlayerName: @Model!.PlayerName</li>
    <li>Gestart met spelen: @Model!.StartedPlayingOn</li>
</ul>

<form asp-action="ThrowBomb" asp-route-gameId="@Model!.Id" method="post" class="row g-2 mb-3">
    @Html.AntiForgeryToken()
    <div class="col-sm-3">
        <label for="letter" class="form-label">Letter (A-T)</label>
        <input id="letter" name="letter" class="form-control" maxlength="1" required />
    </div>
    <div class="col-sm-3">
        <label for="number" class="form-label">Nummer (1-10)</label>
        <input id="number" name="number" type="number" min="1" max="10" class="form-control" required />
    </div>
    <div class="col-sm-6 align-self-end">
        <button type="submit" class="btn btn-primary">Gooi bom</button>
        <a asp-controller="Games" asp-action="Index" class="btn btn-outline-secondary">Stop met spelen</a>
    </div>
</form>

<h3>Bom info:</h3>
<ul>
    <li>Locatie: @location</li>
    <li>Resultaat: <span class="@statusClass">@message</span></li>
    <li>Aantal gezonken boten: @sunkCount</li>
</ul>


